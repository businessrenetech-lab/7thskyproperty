23:Tbb9,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What skills are tested in the PTE Listening section?","acceptedAnswer":{"@type":"Answer","text":"Identifying key information from spoken audio clips, understanding different English accents, accurate note-taking under time pressure, identifying errors in spoken content, writing from dictation, and selecting the most appropriate summary."}},{"@type":"Question","name":"How do I choose the right course?","acceptedAnswer":{"@type":"Answer","text":"Start with a free consultation. Our academic advisors assess your current level, timeline, and target score to recommend the perfect course and batch for you."}},{"@type":"Question","name":"Do you offer flexible schedules?","acceptedAnswer":{"@type":"Answer","text":"Yes. We run weekday morning, afternoon, and weekend batches so you can fit serious preparation into your busy routine."}},{"@type":"Question","name":"Is mock test support included?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. All courses include AI-scored full-length mock tests, detailed analytics, and trainer-led review sessions."}},{"@type":"Question","name":"What is the class size?","acceptedAnswer":{"@type":"Answer","text":"We maintain a maximum of 12 students per cohort to ensure personalized attention, stronger accountability, and faster improvement."}},{"@type":"Question","name":"What is the difference between PTE and IELTS?","acceptedAnswer":{"@type":"Answer","text":"PTE Academic is fully computer-based with AI scoring and results in 1–2 days, while IELTS has a face-to-face speaking test with results in 3–13 days. Both are accepted worldwide. PTE is especially popular for Australia and New Zealand immigration."}},{"@type":"Question","name":"What PTE score do I need to study in Australia?","acceptedAnswer":{"@type":"Answer","text":"For Australian student visas, you typically need a PTE score of 50–65 depending on the course. For Skilled Migration (PR), a PTE score of 65+ is generally required, with higher scores earning additional points."}},{"@type":"Question","name":"Do you offer study abroad consulting?","acceptedAnswer":{"@type":"Answer","text":"Yes. Along with PTE and IELTS coaching, we provide study abroad guidance for Australia, Canada, UK, New Zealand, and more. Our advisors help with university selection, visa requirements, and score targets."}},{"@type":"Question","name":"Can I prepare for PTE or IELTS online?","acceptedAnswer":{"@type":"Answer","text":"Yes. Language Academy offers both online and offline classes from our Dhanmondi, Dhaka centre. Online students get the same curriculum, AI mock tests, and trainer support as in-person learners."}},{"@type":"Question","name":"How long does PTE or IELTS preparation take?","acceptedAnswer":{"@type":"Answer","text":"Most students achieve their target score within 4–8 weeks of focused preparation. The exact timeline depends on your current English level and target score."}}]}16:[["$","script",null,{"type":"application/ld+json","suppressHydrationWarning":true,"dangerouslySetInnerHTML":{"__html":"$23"}}],["$","script",null,{"type":"application/ld+json","suppressHydrationWarning":true,"dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://languageacademy.com.bd\"}]}"}}],"$L24"]
