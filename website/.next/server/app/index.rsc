d:T56a,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What skills are tested in the PTE Listening section?","acceptedAnswer":{"@type":"Answer","text":"Identifying key information from spoken audio clips, understanding different English accents, accurate note-taking under time pressure, identifying errors in spoken content, writing from dictation, and selecting the most appropriate summary."}},{"@type":"Question","name":"How do I choose the right course?","acceptedAnswer":{"@type":"Answer","text":"Start with a free consultation. Our academic advisors assess your current level, timeline, and target score to recommend the perfect course and batch for you."}},{"@type":"Question","name":"Do you offer flexible schedules?","acceptedAnswer":{"@type":"Answer","text":"Yes. We run weekday morning, afternoon, and weekend batches so you can fit serious preparation into your busy routine."}},{"@type":"Question","name":"Is mock test support included?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. All courses include AI-scored full-length mock tests, detailed analytics, and trainer-led review sessions."}},{"@type":"Question","name":"What is the class size?","acceptedAnswer":{"@type":"Answer","text":"We maintain a maximum of 12 students per cohort to ensure personalized attention, stronger accountability, and faster improvement."}}]}2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://languageacademy.com.bd\"}]}"}}],["$","$Le",null,{"courses":[{"id":3,"title":"PTE Basic","slug":"pte-basic","category":"PTE","level":"beginner","base_fee":"5500.00","duration_weeks":2,"image_url":null,"short_description":"2 Weeks, 4 classes. (Unlimited Mock test 