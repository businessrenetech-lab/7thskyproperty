# ─── Website (Next.js) — Hostinger production env ─────────────────────────
# Copy to `.env.production` (or set in hPanel Node.js App env vars) on the
# main-domain Node app. Passenger assigns PORT automatically.

NODE_ENV=production

# The Express API origin (its own subdomain). The website proxies its relative
# /api and /uploads calls here (see next.config.mjs production rewrites), and
# server-side fetches go straight to it via INTERNAL_API_URL.
NEXT_PUBLIC_API_ORIGIN=https://api.darkgoldenrod-butterfly-615812.hostingersite.com
INTERNAL_API_URL=https://api.darkgoldenrod-butterfly-615812.hostingersite.com

# Optional: analytics
# NEXT_PUBLIC_FB_PIXEL_ID=
