# ─── Backend API — Hostinger production env ───────────────────────────────
# Copy to `.env` inside the API Node.js app root on Hostinger and fill in.
# Passenger assigns PORT automatically — do NOT hardcode it in production.

NODE_ENV=production
TZ=Asia/Dhaka
# PORT is injected by Hostinger/Passenger. Leave unset in production.

# ─── MySQL (from hPanel → Databases → MySQL) ──────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uXXXXXXX_seventhsky
DB_USER=uXXXXXXX_admin
DB_PASS=your_strong_db_password

# ─── Security (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ─
JWT_SECRET=replace_with_a_long_random_64plus_char_string
ENCRYPTION_KEY=replace_with_a_32_byte_hex_key

# ─── Google Sign-In (Google Identity Services) ────────────────────────────
# The OAuth 2.0 Web client ID. Public value; safe to commit. In Google Cloud
# Console → Credentials → this client → add your domains to
# "Authorized JavaScript origins" (e.g. https://<your-domain>).
GOOGLE_CLIENT_ID=82959977221-3k1ag8ofcgrp9kuvtbj9ld4dvhhmpobm.apps.googleusercontent.com

# ─── Public URLs (use YOUR real domains) ──────────────────────────────────
# The website (main domain) and the API subdomain that serves /api, /uploads, /admin.
APP_BASE_URL=https://www.seventhskypropertycare.com
WEBSITE_BASE_URL=https://www.seventhskypropertycare.com
SIGN_BASE_URL=https://www.seventhskypropertycare.com/sign
PORTAL_BASE_URL=https://www.seventhskypropertycare.com
PUBLIC_APP_URL=https://www.seventhskypropertycare.com
PUBLIC_API_URL=https://www.seventhskypropertycare.com
PUBLIC_ADMIN_URL=https://www.seventhskypropertycare.com/admin
BACKEND_URL=https://www.seventhskypropertycare.com

# Origins allowed to call the API (website + the admin origin). Comma-separated.
CORS_ORIGINS=https://www.seventhskypropertycare.com,https://seventhskypropertycare.com

# ─── Serve the admin SPA from this API app at /admin (single origin) ──────
# Point to the built admin-portal/dist you upload alongside the backend.
ADMIN_DIST=/home/uXXXXXXX/api.domain/admin-dist

# ─── Signing / public link base URLs (used in emails) ─────────────────────
APPLY_BASE_URL=https://www.seventhskypropertycare.com/apply
APPROVE_BASE_URL=https://www.seventhskypropertycare.com/approve
REFERENCE_BASE_URL=https://www.seventhskypropertycare.com/reference

# ─── Email (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@seventhskypropertycare.com
SMTP_PASS=set_in_hpanel_or_SystemSetting_never_here
ADMIN_NOTIFICATION_EMAILS=info@seventhskypropertycare.com

# ─── Payment gateway (SSLCommerz) — fill if used ──────────────────────────
# STORE_ID=
# STORE_PASSWORD=
# SSLCZ_IS_LIVE=false

# ─── DB pool (safe shared-hosting defaults) ───────────────────────────────
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_SYNC_ALTER=false
