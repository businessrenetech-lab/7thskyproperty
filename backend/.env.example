PORT=5000
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
JWT_SECRET=replace_with_64_char_random_string_use_crypto_randomBytes
NODE_ENV=development
TZ=Asia/Dhaka
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Production CORS origins (comma-separated, no trailing slashes)
# CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Database sync mode — NEVER set true in production
DB_SYNC_ALTER=false

# Seed password (only used during seeding)
# SEED_DEFAULT_PASSWORD=your_secure_seed_password

# Facebook Conversions API (Server-Side Tracking)
FB_PIXEL_ID=YOUR_PIXEL_ID_HERE
FB_CAPI_TOKEN=YOUR_SYSTEM_USER_ACCESS_TOKEN_HERE
